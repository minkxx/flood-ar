{
   "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
   "vcs": {
      "enabled": true,
      "clientKind": "git",
      "useIgnoreFile": true
   },
   "files": {
      "ignoreUnknown": true
   },
   "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 3,
      "lineWidth": 80
   },
   "linter": {
      "enabled": true,
      "rules": {
         "preset": "recommended",
         "suspicious": {
            "noExplicitAny": "warn"
         },
         "style": {
            "useImportType": "error"
         }
      }
   },
   "javascript": {
      "formatter": {
         "quoteStyle": "single",
         "semicolons": "always",
         "trailingCommas": "all"
      }
   },
   "json": {
      "formatter": {
         "enabled": true
      }
   }
}
