{
   "name": "flood-detection-system",
   "private": true,
   "version": "0.1.0",
   "packageManager": "pnpm@11.21.0",
   "engines": {
      "node": ">=22"
   },
   "scripts": {
      "lint": "biome lint .",
      "lint:fix": "biome lint --write .",
      "format": "biome format --write .",
      "check": "biome check .",
      "check:fix": "biome check --write .",
      "typecheck": "pnpm -r run typecheck",
      "build:shared": "pnpm --filter shared build",
      "build": "pnpm -r run build",
      "dev:server": "pnpm --filter server dev",
      "dev:dashboard": "pnpm --filter dashboard dev",
      "dev:simulator": "pnpm --filter simulator dev"
   },
   "devDependencies": {
      "@biomejs/biome": "^2.1.2",
      "typescript": "^5.6.3"
   }
}
